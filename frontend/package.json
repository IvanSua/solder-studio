{
  "name": "tienda-de-ropa-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ssr": "ng build && ng run tienda-de-ropa:server",
    "serve:ssr": "node dist/tienda-de-ropa/server/server.mjs",
    "test": "ng test",
    "test:watch": "ng test --watch=true",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadlessNoSandbox",
    "test:coverage": "ng test --code-coverage --no-watch --browsers=ChromeHeadlessNoSandbox",
    "test:chrome": "ng test --browsers=Chrome",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:pw": "playwright test",
    "e2e:pw:ui": "playwright test --ui",
    "e2e:pw:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/service-worker": "^19.2.20",
    "@angular/ssr": "^19.0.0",
    "express": "^4.18.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@sentry/angular": "^10.46.0",
    "@sentry/browser": "^10.46.0",
    "konva": "^9.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular-eslint/builder": "^22.6.0",
    "@eslint/js": "^9.0.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^19.0.0",
    "eslint": "^9.0.0",
    "jasmine-core": "~5.4.0",
    "jimp": "^1.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0",
    "@playwright/test": "^1.49.0",
    "@types/express": "^4.17.21"
  }
}
