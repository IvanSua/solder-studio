# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para producción
# Copiá este archivo como .env y completá los valores antes de levantar con:
#   docker compose -f docker-compose.prod.yml up
#
# SECRETS (sensibles) — se pasan por archivo vía secrets/create-secrets.sh:
#   DB_PASSWORD, JWT_SECRET, MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET,
#   MAIL_PASSWORD, STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://solderstudio.com.ar
CORS_ORIGINS=https://solderstudio.com.ar

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@solderstudio.com.ar
# La contraseña va en secrets/mail_password

# ── MercadoPago ───────────────────────────────────────────────────────────────
MP_NOTIFICATION_URL=https://solderstudio.com.ar/api/v1/payments/webhook
# MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET van en secrets/

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Redirect URI: https://solderstudio.com.ar/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth2 ───────────────────────────────────────────────────────────
# Redirect URI: https://solderstudio.com.ar/login/oauth2/code/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generá las claves UNA SOLA VEZ con:
#   node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2));"
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:noreply@solderstudio.com.ar

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENABLED=false
