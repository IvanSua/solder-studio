{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Checkout",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Checkouts iniciados (1h)",
      "type": "stat",
      "targets": [{ "expr": "increase(tienda_checkout_initiated_total[1h])", "legendFormat": "Total" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.9 }] }, "unit": "percentunit", "max": 1, "min": 0 }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Tasa de éxito checkout",
      "type": "stat",
      "targets": [{
        "expr": "sum(increase(tienda_checkout_completed_total{result=\"success\"}[1h])) / sum(increase(tienda_checkout_completed_total[1h]))",
        "legendFormat": "Success rate"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Duración promedio checkout (p95)",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(tienda_checkout_duration_seconds_bucket[5m]))", "legendFormat": "p95" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "title": "Checkouts completados por método de pago",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (payment_method) (rate(tienda_checkout_completed_total{result=\"success\"}[5m]))", "legendFormat": "{{payment_method}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "title": "Errores de checkout por método",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (payment_method) (rate(tienda_checkout_completed_total{result=\"error\"}[5m]))", "legendFormat": "{{payment_method}} errors" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Órdenes",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 6,
      "title": "Cambios de estado de órdenes",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (to_status) (rate(tienda_order_status_changed_total[5m]))", "legendFormat": "→ {{to_status}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Loyalty & Referidos",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 23 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Puntos otorgados (24h)",
      "type": "stat",
      "targets": [{ "expr": "increase(tienda_loyalty_points_awarded_total[24h])", "legendFormat": "Points" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 23 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Puntos canjeados (24h)",
      "type": "stat",
      "targets": [{ "expr": "increase(tienda_loyalty_points_redeemed_total[24h])", "legendFormat": "Redeemed" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 9,
      "title": "Puntos otorgados por razón",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (reason) (rate(tienda_loyalty_points_awarded_total[5m]))", "legendFormat": "{{reason}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 10,
      "title": "Bonos de referidos por tipo",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (type) (rate(tienda_referral_bonus_awarded_total[5m]))", "legendFormat": "{{type}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 103,
      "title": "JVM & Sistema",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "id": 11,
      "title": "Uso de memoria JVM",
      "type": "timeseries",
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "Heap used" },
        { "expr": "jvm_memory_committed_bytes{area=\"heap\"}", "legendFormat": "Heap committed" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "id": 12,
      "title": "CPU usage",
      "type": "timeseries",
      "targets": [{ "expr": "process_cpu_usage", "legendFormat": "CPU" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "id": 13,
      "title": "HTTP requests/s por endpoint",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{method}} {{uri}}" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["tiendaropa", "business"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "America/Argentina/Buenos_Aires",
  "title": "TiendaRopa — Business Metrics",
  "uid": "tiendaropa-business",
  "version": 1
}
